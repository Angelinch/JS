{
  "name": "js",
  "version": "1.0.0",
  "description": "Создано в рамках курса OTUS JavaScript QA Engineer",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --runInBand", 
    "allure:serve": "allure serve reports/allure-results",
    "allure:generate": "allure generate reports/allure-results --clean --report-dir reports/allure-report",
    "allure:open": "allure open reports/allure-report"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "reporters": [
      "default",
      ["jest-html-reporters", {
        "publicPath": "reports/html",
        "filename": "report.html",
        "expand": true,
        "pageTitle": "Test Report",
        "includeFailureMsg": true,
        "includeConsoleLog": true
      }]
    ],
    "testMatch": ["**/specs/**/*.test.ts"]
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "allure-commandline": "^2.34.1",
    "allure-jest": "^3.4.1",
    "jest": "^30.0.5",
    "jest-environment-node": "^30.2.0",
    "jest-html-reporters": "^3.1.7",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Angelinch/JS.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Angelinch/JS/issues"
  },
  "homepage": "https://github.com/Angelinch/JS#readme"
}
